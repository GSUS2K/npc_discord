{
  "name": "npc-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A memory-driven resident for gaming Discord servers.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "register": "tsx src/registerCommands.ts",
    "register:prod": "node dist/registerCommands.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "discord-api-types": "^0.37.119",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
